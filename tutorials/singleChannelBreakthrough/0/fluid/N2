FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      N2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];
internalField   uniform 1;
boundaryField
{
    inlet           { type uniformFixedValue; uniformValue table ( (0 1) (0.3 1) (0.3001 0.9993715) (1e6 0.9993715) ); }
    outlet          { type inletOutlet; inletValue uniform 1; value uniform 1; }
    fluid_to_solid  { type zeroGradient; }
}

