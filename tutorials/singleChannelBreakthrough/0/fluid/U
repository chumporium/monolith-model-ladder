FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/fluid";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0.72);
boundaryField
{
    inlet           { type fixedValue; value uniform (0 0 0.72); }
    outlet          { type zeroGradient; }
    fluid_to_solid  { type noSlip; }
}

