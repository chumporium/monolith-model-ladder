FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/solid";
    object      C.CO2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// CO2 concentration in the pore gas of the wall [kg/m3]
dimensions      [1 -3 0 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    solidInlet      { type zeroGradient; }
    solidOutlet     { type zeroGradient; }
    outerWall       { type symmetry; }
    solid_to_fluid
    {
        type            speciesCoupledMixed;
        phase           solid;
        nbrField        CO2;
        DField          Ds.CO2;
        rho             rho;
        value           uniform 0;
    }
}

// ************************************************************************* //
