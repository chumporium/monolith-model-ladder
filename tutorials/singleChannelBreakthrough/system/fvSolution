FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh { solver GAMG; smoother GaussSeidel; tolerance 1e-7; relTol 0.01; }
    p_rghFinal { $p_rgh; relTol 0; }
    "(U|h|C.*|CO2|N2|Yi)" { solver PBiCGStab; preconditioner DILU; tolerance 1e-8; relTol 0.01; }
    "(U|h|C.*|CO2|N2|Yi)Final" { $U; relTol 0; }
}

// Region coupling, read by the solver from this top-level fvSolution
PIMPLE
{
    nOuterCorrectors        4;           // outer (fluid-wall interface) iterations per time step
    nCorrectors             2;
    nNonOrthogonalCorrectors 1;
    momentumPredictor       yes;
}

relaxationFactors
{
    fields    { p_rgh 0.7; }
    equations { U 0.9; h 0.9; "C.*" 0.9; "(CO2|N2|Yi)" 1; }
}

