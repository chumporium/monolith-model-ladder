FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 0.001;

// Unit cell of a square-channel monolith: 2.0 mm channel, 0.2 mm half-wall
// (2.4 mm pitch), length 80 mm. The channel is the cellZone 'fluid' and the
// surrounding wall the cellZone 'solid'; splitMeshRegions turns them into the
// two regions of the solver.
vertices
(
    (0    0    0)
    (0.2  0    0)
    (2.2  0    0)
    (2.4  0    0)
    (0    0.2  0)
    (0.2  0.2  0)
    (2.2  0.2  0)
    (2.4  0.2  0)
    (0    2.2  0)
    (0.2  2.2  0)
    (2.2  2.2  0)
    (2.4  2.2  0)
    (0    2.4  0)
    (0.2  2.4  0)
    (2.2  2.4  0)
    (2.4  2.4  0)
    (0    0    80)
    (0.2  0    80)
    (2.2  0    80)
    (2.4  0    80)
    (0    0.2  80)
    (0.2  0.2  80)
    (2.2  0.2  80)
    (2.4  0.2  80)
    (0    2.2  80)
    (0.2  2.2  80)
    (2.2  2.2  80)
    (2.4  2.2  80)
    (0    2.4  80)
    (0.2  2.4  80)
    (2.2  2.4  80)
    (2.4  2.4  80)
);

nz 16;    // axial cells
nf 6;     // cells across the channel
nw 2;     // cells across the half-wall

blocks
(
    hex (5 6 10 9  21 22 26 25) fluid ($nf $nf $nz) simpleGrading (1 1 1)
    hex (1 2 6 5   17 18 22 21) solid ($nf $nw $nz) simpleGrading (1 1 1)
    hex (9 10 14 13  25 26 30 29) solid ($nf $nw $nz) simpleGrading (1 1 1)
    hex (4 5 9 8   20 21 25 24) solid ($nw $nf $nz) simpleGrading (1 1 1)
    hex (6 7 11 10  22 23 27 26) solid ($nw $nf $nz) simpleGrading (1 1 1)
    hex (0 1 5 4   16 17 21 20) solid ($nw $nw $nz) simpleGrading (1 1 1)
    hex (2 3 7 6   18 19 23 22) solid ($nw $nw $nz) simpleGrading (1 1 1)
    hex (8 9 13 12  24 25 29 28) solid ($nw $nw $nz) simpleGrading (1 1 1)
    hex (10 11 15 14  26 27 31 30) solid ($nw $nw $nz) simpleGrading (1 1 1)
);

boundary
(
    inlet  { type patch; faces ( (6 5 9 10) ); }
    outlet { type patch; faces ( (21 22 26 25) ); }
    solidInlet
    {
        type wall;
        faces ( (1 0 4 5) (2 1 5 6) (3 2 6 7) (5 4 8 9) (7 6 10 11) (9 8 12 13) (10 9 13 14) (11 10 14 15) );
    }
    solidOutlet
    {
        type wall;
        faces ( (16 17 21 20) (17 18 22 21) (18 19 23 22) (20 21 25 24) (22 23 27 26) (24 25 29 28) (25 26 30 29) (26 27 31 30) );
    }
    // Symmetry at the mid-plane of the wall: neighbouring channels behave the same.
    outerWall
    {
        type symmetry;
        faces
        (
            (0 16 20 4) (4 20 24 8) (8 24 28 12) (3 7 23 19) (7 11 27 23) (11 15 31 27)
            (0 1 17 16) (1 2 18 17) (2 3 19 18) (13 12 28 29) (14 13 29 30) (15 14 30 31)
        );
    }
);

