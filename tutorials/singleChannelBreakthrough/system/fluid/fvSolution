FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/fluid";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    rho      { solver PCG; preconditioner DIC; tolerance 1e-7; relTol 0.1; }
    rhoFinal { $rho; relTol 0; }
    p_rgh    { solver GAMG; smoother DICGaussSeidel; tolerance 1e-5; relTol 0.05; }
    p_rghFinal { $p_rgh; tolerance 1e-6; relTol 0; }
    "(U|h)"  { solver PBiCGStab; preconditioner DILU; tolerance 1e-7; relTol 0.1; }
    "(U|h)Final" { $U; relTol 0; }
    "(Yi|CO2|N2)" { solver PBiCGStab; preconditioner DILU; tolerance 1e-9; relTol 0.01; }
    "(Yi|CO2|N2)Final" { $Yi; relTol 0; }
}
PIMPLE
{
    momentumPredictor       yes;
    nCorrectors             2;
    nNonOrthogonalCorrectors 1;
}
relaxationFactors
{
    fields    { p_rgh 0.7; }
    equations { "U.*" 0.7; "h.*" 0.7; "(Yi|CO2|N2).*" 1; }
}

