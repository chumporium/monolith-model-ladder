FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application         adsorptionMultiRegionFoam;
libs                ("libadsorptionCoupledBCs.so");

startFrom           latestTime;
startTime           0;
stopAt              endTime;
endTime             300;

deltaT              1e-4;
adjustTimeStep      yes;
maxCo               2;
maxDi               1e6;
maxDeltaT           0.5;

writeControl        adjustableRunTime;
writeInterval       60;
purgeWrite          0;
writeFormat         ascii;
writePrecision      7;
timeFormat          general;
timePrecision       6;
runTimeModifiable   yes;

functions
{
    // Flow-weighted CO2 mass fraction at the outlet: the breakthrough curve.
    outletCO2
    {
        type surfaceFieldValue; libs (fieldFunctionObjects); region fluid;
        regionType patch; name outlet;
        operation weightedAverage; weightField phi; fields (CO2);
        writeControl timeStep; writeInterval 5;
        log false; writeFields false; surfaceFormat none;
    }
    // Mean loading q.CO2 [mol/kg] and mean temperature of the wall.
    solidAverage
    {
        type volFieldValue; libs (fieldFunctionObjects); region solid;
        operation volAverage; fields (q.CO2 T);
        writeControl timeStep; writeInterval 5;
        log false; writeFields false;
    }
}

